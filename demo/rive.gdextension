[configuration]

entry_symbol = "rive_library_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_64 = "bin/librive.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/librive.windows.template_release.x86_64.dll"

[icons]

RiveViewer = "icons/rive_viewer_icon.svg"
RiveViewer2D = "icons/rive_viewer_2d_icon.svg"
