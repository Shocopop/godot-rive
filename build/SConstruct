from pathlib import Path

env = SConscript('../godot-cpp/SConstruct')
if env['platform'] != 'windows' or env['arch'] != 'x86_64':
    print('The Rive GPU backend currently supports Windows x86_64 with Vulkan only.')
    Exit(1)
rive = Path('../thirdparty/rive-cpp')
output = rive / 'renderer/out/release'
names = ['rive', 'rive_pls_renderer', 'rive_decoders', 'rive_harfbuzz',
         'rive_sheenbidi', 'rive_yoga', 'libwebp', 'libpng', 'zlib', 'libjpeg']
libraries = []
for name in names:
    matches = list(output.rglob(name + '.lib'))
    if len(matches) != 1:
        print(f'Missing or ambiguous {name}.lib. Run build.py to build Rive first.')
        Exit(1)
    libraries.append(str(matches[0]))
env.Append(CPPPATH=['../src', str(rive / 'include'), str(rive / 'renderer/include'),
    str(rive / 'renderer/dependencies/KhronosGroup_Vulkan-Headers_vulkan-sdk-1.4.321/include')])
env.Append(CPPDEFINES=['RIVE_VULKAN', 'VK_NO_PROTOTYPES', 'WITH_RIVE_TEXT', 'WITH_RIVE_LAYOUT', 'RIVE_WINDOWS', 'NDEBUG', 'NOMINMAX'])
env.Append(LIBS=[File(p) for p in libraries] + ['user32', 'gdi32', 'opengl32', 'd3d11', 'd3d12', 'dxgi', 'dxguid', 'd3dcompiler'])
env.Append(CXXFLAGS=['/std:c++20', '/EHsc', '/GR'])
sources = [str(p) for p in Path('../src').rglob('*.cpp')]
library = env.SharedLibrary('../demo/bin/librive' + env['suffix'] + env['SHLIBSUFFIX'], source=sources)
Default(library)
