{
    "configurations": [
        {
            "name": "Windows",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/godot-cpp/include",
                "${workspaceFolder}/godot-cpp/gen/include",
                "${workspaceFolder}/thirdparty/rive-cpp",
                "${workspaceFolder}/thirdparty/rive-cpp/include",
                "${workspaceFolder}/godot-cpp/gdextension",
                "${workspaceFolder}/thirdparty/rive-cpp/renderer/include",
                "${workspaceFolder}/thirdparty/rive-cpp/renderer/dependencies/KhronosGroup_Vulkan-Headers_vulkan-sdk-1.4.321/include"
            ],
            "defines": ["RIVE_VULKAN", "VK_NO_PROTOTYPES", "WITH_RIVE_TEXT", "WITH_RIVE_LAYOUT", "NDEBUG"],
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64",
            "browse": {
                "limitSymbolsToIncludedHeaders": true,
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/godot-cpp/include",
                    "${workspaceFolder}/godot-cpp/gen/include",
                    "${workspaceFolder}/thirdparty/rive-cpp/include",
                    "${workspaceFolder}/thirdparty/rive-cpp/renderer/include"
                ]
            }
        }
    ],
    "version": 4
}
